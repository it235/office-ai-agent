{
  "version": 1,
  "cases": [
    {
      "id": "S-skill-gate",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "DeleteText",
      "allowedTools": ["InsertText"],
      "expectedErrorCode": "TOOL_NOT_ALLOWED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-vba-disabled",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "ExecuteVBA",
      "allowedTools": ["ExecuteVBA"],
      "params": {"code": "Sub Test(): End Sub"},
      "expectedErrorCode": "VBA_DISABLED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-host-isolation",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "WriteData",
      "allowedTools": ["WriteData"],
      "expectedErrorCode": "HOST_UNSUPPORTED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-argument-required",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "SetParagraphFormat",
      "allowedTools": ["SetParagraphFormat"],
      "params": {"alignment": "center", "afterSpacing": 12},
      "expectedErrorCode": "ARGUMENT_ERROR",
      "expectedHostCalls": 0
    },
    {
      "id": "S-approval-resume",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "DeleteText",
      "allowedTools": ["DeleteText"],
      "approvedTools": ["DeleteText"],
      "params": {"range": "selection"},
      "expectedSuccess": true,
      "expectedHostCalls": 1
    },
    {
      "id": "C-tool-result-observation",
      "kind": "contract",
      "contractType": "tool_result",
      "expectedObservation": true
    },
    {
